# Hardware — host machine, never containerized
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Root directory containing all project codebases
WORKSPACES_PATH=/home/maispace/Projects

# Embedding provider — Ollama only (used for management + code embeddings)
EMBEDDING_MODEL=ollama:nomic-embed-text

# Dashboard (M4/M5)
DASHBOARD_SECRET=change-me

# NOTE: coding agents (claude, opencode) authenticate client-side with their
# own providers — the stack itself talks to no provider other than Ollama.
