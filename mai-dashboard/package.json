{
  "name": "mai-dashboard",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:frontend": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:frontend && npm run build:server",
    "start": "node dist-server/index.js",
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "ws": "^8.18.0",
    "redis": "^4.7.0",
    "reactflow": "^11"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5",
    "tsx": "^4.15.7",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.1",
    "vitest": "^2.1.9",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.0.1"
  }
}
