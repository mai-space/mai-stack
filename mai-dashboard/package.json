{
  "name": "mai-dashboard",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:frontend": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:frontend && npm run build:server",
    "start": "node dist-server/index.js",
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.11.3",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "ws": "^8.21.3",
    "redis": "^6.2.1",
    "reactflow": "^11"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "tsx": "^4.23.12",
    "vite": "^8.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "vitest": "^4.1.10",
    "jsdom": "^30.0.1",
    "@testing-library/react": "^16.0.1"
  }
}
